CREATE TABLE STUBSERVER_VSDETAILS
(
    VSID        NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    VSNAME      VARCHAR(255) UNIQUE,
    PORT        NUMBER(10),
    LASTUPDATED VARCHAR(30),
    USERNAME    VARCHAR(255),
    STATUS      VARCHAR(10)
);

ALTER TABLE STUBSERVER_VSDETAILS ADD XMLCONTENT CLOB;

ALTER TABLE stubserver_vsdetails
ADD KEEPREQRESLOGSDAYS VARCHAR(20) DEFAULT '15';

CREATE TABLE stubserver_txnMetrics(
    serviceName varchar(100),
    PORT INT,
    transaction_date DATE,
    count INT DEFAULT 0,
    PRIMARY KEY (serviceName, transaction_date)
);

CREATE TABLE STUBSERVER_VSDETAILS_TEST as select * from STUBSERVERQA_VSDETAILS where 1=0;
